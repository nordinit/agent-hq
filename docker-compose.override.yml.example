###############################################################################
# Optional local overrides. Copy to docker-compose.override.yml; that file is
# ignored because it may contain credentials.
###############################################################################

services:
  agent-hq-api:
    # ports:
    #   - "4501:3501"
    environment:
      # Add OpenClaw/provider integration settings here when needed.
      # OPENCLAW_GATEWAY_URL: "https://host.docker.internal:18789"
      NODE_ENV: production

  agent-hq-ui:
    # ports:
    #   - "4500:3500"
    build:
      args:
        NEXT_PUBLIC_API_URL: "http://localhost:3501"

  # PostgreSQL is intentionally not published to the host by default. Uncomment
  # only when a host-side tool needs a direct connection.
  agent-hq-postgres:
    # ports:
    #   - "5432:5432"
    environment:
      POSTGRES_PASSWORD: "replace-with-a-local-secret"
