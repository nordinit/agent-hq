{
  "name": "agent-hq-api",
  "version": "1.0.0",
  "description": "Agent HQ API \u2014 agent management backend",
  "main": "dist/index.js",
  "bin": {
    "agent-hq-mcp": "dist/mcp/server.js",
    "agent-hq-tool-mcp": "dist/bin/agent-tool-mcp.js"
  },
  "scripts": {
    "mcp": "tsx src/mcp/server.ts",
    "dev": "tsx watch src/index.ts",
    "dev:dev": "AGENT_HQ_DB_PATH=../agent-hq-dev.db PORT=3511 tsx watch src/index.ts",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "db:migrate": "node dist/db/migrate.js",
    "db:install": "node dist/db/migrate.js",
    "db:migrate:preflight": "node dist/db/migrate.js",
    "db:repair-tenants": "node dist/db/repair-tenant-ownership.js",
    "db:migrate:status": "node dist/db/migrateStatus.js",
    "db:provision-defaults": "npx tsx src/db/provision-defaults.ts",
    "start": "node dist/index.js",
    "start:dev": "AGENT_HQ_DB_PATH=../agent-hq-dev.db PORT=3511 node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:chat-deep-link": "jest --runInBand --config '{\"preset\":\"ts-jest\",\"testEnvironment\":\"node\",\"testMatch\":[\"**/src/lib/chatDeepLink.test.js\"]}'",
    "seed:dev": "AGENT_HQ_DB_PATH=../agent-hq-dev.db npx tsx src/db/seed-dev.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "globalSetup": "<rootDir>/src/db/jest-global-setup.ts",
    "setupFiles": [
      "<rootDir>/src/db/jest-setup-env.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/db/jest-after-env.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/multer": "^2.1.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "playwright-core": "^1.58.2",
    "simple-git": "^3.36.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "hono": "^4.12.25",
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.5.2",
    "ip-address": "^10.2.0",
    "fast-uri": "^3.1.2",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.20.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
