# Docker/self-hosted ports
AGENT_HQ_API_PORT=3501
AGENT_HQ_UI_PORT=3500
NEXT_PUBLIC_API_URL=http://localhost:3501

# Bundled PostgreSQL 17 defaults. The database is private to the Compose network.
AGENT_HQ_POSTGRES_DB=agent_hq
AGENT_HQ_POSTGRES_USER=agenthq
# This value is also interpolated into a PostgreSQL URI. Use URL-safe characters here;
# for other characters, set DATABASE_URL separately with a percent-encoded password.
AGENT_HQ_POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value

# To use an external PostgreSQL server instead, set its full connection URL.
# DATABASE_URL=postgresql://agenthq:password@db.example.com:5432/agent_hq

# Native (--no-docker) mode requires DATABASE_URL or AGENT_HQ_DATABASE_URL.
# AGENT_HQ_DATABASE_URL=postgresql://agenthq:password@127.0.0.1:5432/agent_hq

# Optional native-mode filesystem root. Compose sets this to its persistent uploads volume.
# AGENT_HQ_UPLOADS_DIR=/srv/agent-hq/uploads
