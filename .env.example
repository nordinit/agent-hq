# Docker/self-hosted ports
AGENT_HQ_API_PORT=3501
AGENT_HQ_UI_PORT=3500
NEXT_PUBLIC_API_URL=http://localhost:3501

# Operator token: the credential for the UI sign-in page and for the API (as
# "Authorization: Bearer <token>"). Required. The API refuses to start without it, and
# Docker Compose refuses to run. Give the API and the UI the same value; generate one with
#   openssl rand -hex 32
# Rotating it signs every UI session out. `agent-hq start` generates one for you.
AGENT_HQ_OPERATOR_TOKEN=
# enforce (default): every /api/v1 request must present the operator token or an agent
# MCP key. report: requests that would be refused are still served, and each distinct
# caller is logged once as "[api-auth:report] would reject". Use report only to find
# callers during an upgrade, then switch back to enforce.
# AGENT_HQ_AUTH_MODE=enforce

# Network exposure. Agents run commands on this host, so the API and UI listen on loopback
# only by default. Change these only behind TLS (a reverse proxy or tunnel).
# AGENT_HQ_BIND_ADDRESS=127.0.0.1   # Docker: host address the ports are published on
# HOST=127.0.0.1                    # Native: API listen address
# AGENT_HQ_UI_HOST=127.0.0.1        # Native: UI listen address
# Extra browser origins allowed to call /api/v1 directly (comma-separated). The UI's own
# pages go through its server-side proxy and need no entry here.
# AGENT_HQ_ALLOWED_ORIGINS=

# Bundled PostgreSQL 17 defaults. The database is private to the Compose network.
AGENT_HQ_POSTGRES_DB=agent_hq
AGENT_HQ_POSTGRES_USER=agenthq
# This value is also interpolated into a PostgreSQL URI. Use URL-safe characters here;
# for other characters, set DATABASE_URL separately with a percent-encoded password.
AGENT_HQ_POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value

# To use an external PostgreSQL server instead, set its full connection URL.
# DATABASE_URL=postgresql://agenthq:password@db.example.com:5432/agent_hq

# Native (--no-docker) mode requires DATABASE_URL or AGENT_HQ_DATABASE_URL.
# AGENT_HQ_DATABASE_URL=postgresql://agenthq:password@127.0.0.1:5432/agent_hq

# Optional native-mode filesystem root. Compose sets this to its persistent uploads volume.
# AGENT_HQ_UPLOADS_DIR=/srv/agent-hq/uploads

# Host path and executable policy. Agents run commands on this host, so the directories and
# binaries an agent record may name are confined. Values are path-delimiter (":") separated
# absolute paths; relative entries are ignored.
# Agent workspaces must live under the Agent HQ workspace directory (AGENT_HQ_WORKSPACE_PARENT,
# default ~/.agent-hq/workspaces) or in an OpenClaw workspace (~/.openclaw/workspace-*).
# AGENT_HQ_ALLOWED_WORKSPACE_ROOTS=/srv/agent-workspaces
