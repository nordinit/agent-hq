{
  "name": "agent-hq-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "prebuild": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "build": "next build && node scripts/ensure-standalone-static.js",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3500}",
    "start-dev": "node scripts/clear-stale-dev-port.js && AGENT_HQ_INTERNAL_BASE_URL=${AGENT_HQ_INTERNAL_BASE_URL:-http://localhost:3501} NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:3501} npm run start",
    "lint": "eslint lib/taskStatusEmoji.ts lib/taskStatuses.ts lib/*.test.ts",
    "test": "node --test --experimental-strip-types lib/*.test.ts",
    "verify": "npm run test && npm run lint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.321.0",
    "next": "^15.5.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
